datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  PREMIUM
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  provider      String?        @default("local") // "local" | "google" | "github"
  providerId    String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  watchlists    Watchlist[]
  alerts        Alert[]
  positions     Position[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("My Watchlist")
  symbols   String[] // e.g. ["BTC", "ETH", "SOL"]
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("watchlists")
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  condition   String    // "price_above" | "price_below" | "volume_spike"
  threshold   Float
  channel     String    @default("email") // "email" | "push" | "webhook"
  active      Boolean   @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, symbol])
  @@map("alerts")
}

model Position {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  quantity  Decimal  @db.Decimal(24, 8)
  costBasis Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("positions")
}

// Time-series tables for market data
model Candle {
  id        BigInt   @id @default(autoincrement())
  symbol    String
  interval  String   // "1H" | "4H" | "1D" | "1W" | "1M"
  timestamp DateTime
  open      Decimal  @db.Decimal(18, 8)
  high      Decimal  @db.Decimal(18, 8)
  low       Decimal  @db.Decimal(18, 8)
  close     Decimal  @db.Decimal(18, 8)
  volume    Decimal  @db.Decimal(24, 2)

  @@unique([symbol, interval, timestamp])
  @@index([symbol, interval, timestamp])
  @@map("candles")
}

model WhaleTransaction {
  id         String   @id @default(cuid())
  txHash     String   @unique
  address    String
  type       String   // "buy" | "sell" | "transfer"
  currency   String
  amount     Decimal  @db.Decimal(24, 8)
  usdValue   Decimal  @db.Decimal(18, 2)
  isLarge    Boolean  @default(false)
  occurredAt DateTime

  @@index([occurredAt])
  @@index([currency, occurredAt])
  @@map("whale_transactions")
}

model FearGreedSnapshot {
  id        BigInt   @id @default(autoincrement())
  value     Int
  label     String
  timestamp DateTime @unique

  @@map("fear_greed_snapshots")
}
